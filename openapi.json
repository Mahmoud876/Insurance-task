      "ClaimStatus": {
        "type": "string",
        "enum": [
          "DRAFT",
          "SCRUBBED",
          "SUBMITTED",
          "ACCEPTED",
          "REJECTED",
          "PAID"
        ],
        "title": "ClaimStatus"
      },
      "ClaimUpdate": {
        "properties": {
          "patient_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Patient Id"
          },
          "provider_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Id"
          },
          "payer_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payer Id"
          },
          "service_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Service Date"
          },
          "total_amount": {
            "anyOf": [
              {
                "type": "number",
